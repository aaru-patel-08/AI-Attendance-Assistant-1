# Root OS Files
.DS_Store
Thumbs.db

# Frontend Exclusions
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/dist-ssr/
frontend/*.local

# Backend Exclusions
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/data/*.db

# Python cache (global)
__pycache__/
*.pyc
*.pyo

# Secret Environment Files (Anywhere in the repo)
.env
.env.local
.env.*.local
*.env

# IDE / Editors
.vscode/
.idea/

# Logs
*.log

# Zip files (must not be in GitHub repo)
*.zip
*.rar
*.tar.gz
*.7z

# Generated Excel reports (re-generated at runtime)
backend/data/archive/*.xlsx
